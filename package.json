{
  "name": "wispr-flow-hackathon",
  "version": "1.0.0",
  "description": "Wispr Flow Clone with AI formatting, WPM analytics, and cross-platform support for Hackathon",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "npx concurrently \"node server/index.js\" \"npx vite --port 3000\"",
    "client:dev": "vite --port 3000",
    "build": "npx vite build",
    "client:build": "vite build",
    "server:install": "cd server && npm install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "lucide-react": "^0.363.0",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6"
  }
}
